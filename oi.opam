# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.11.2"
synopsis: "A stateless OCaml package builder"
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy" "Mark Elvers" "Ryan Gibb"]
homepage: "https://github.com/avsm/oi"
bug-reports: "https://github.com/avsm/oi/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.2.0"}
  "dune-build-info"
  "eio_main" {>= "1.0"}
  "d10" {= version}
  "d10ir" {= version}
  "osrel" {= version}
  "opam-format" {>= "2.2.0"}
  "opam-state" {>= "2.2.0"}
  "opam-client" {>= "2.2.0"}
  "opam-repository" {>= "2.2.0"}
  "opam-0install" {>= "0.4"}
  "nox-tty"
  "nox-tty-eio"
  "nox-xdg"
  "cmdliner"
  "fmt"
  "logs"
  "jsont"
  "bytesrw"
  "sqlite3"
  "parsexp"
  "sexplib0"
  "progress"
  "dockerfile" {>= "8.3.9"}
  "dockerfile-opam" {>= "8.3.9"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oi.git"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-assisted"
x-ai-model: "claude-opus-4-6"
x-ai-provider: "Anthropic"
x-repos: ["@avsm"]
