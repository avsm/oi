(data_only_dirs test)

; [static] profile links a musl-static binary on Alpine; used by the
; Dockerfiles generated by `oi registry docker`. Must be built on
; Alpine 3.22 — 3.23's gcc defaults to PIE and the resulting static-pie
; binaries segfault at startup (see
; https://discuss.ocaml.org/t/segfaults-on-static-compilation-with-alpine-3-23-fix-no-pie/17800).

(env
 (static
  (flags
   (:standard -ccopt -static))))
