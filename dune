(data_only_dirs test)

; [static] profile links a musl-static binary on Alpine; used by the
; Dockerfiles generated by `oi registry docker`.
;
; [-ccopt -no-pie] forces a classical static ELF instead of the static-pie
; default Alpine's gcc now emits. Static-pie binaries segfault on some
; kernel/loader combinations (notably GitHub Actions' ubuntu-latest), while
; classical static is universally portable.

(env
 (static
  (flags
   (:standard -ccopt -static -ccopt -no-pie))))
