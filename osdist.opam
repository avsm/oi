# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.14.1"
synopsis: "Native distro packaging (deb/rpm/static) for OCaml projects"
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy" "Mark Elvers" "Ryan Gibb"]
homepage: "https://github.com/avsm/oi"
bug-reports: "https://github.com/avsm/oi/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.2.0"}
  "opam-format" {>= "2.2.0"}
  "jsont" {>= "0.2"}
  "bytesrw" {>= "0.2"}
  "dockerfile" {>= "8.3.9"}
  "dockerfile-opam" {>= "8.3.9"}
  "fmt"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oi.git"
x-maintenance-intent: ["(latest)"]
